<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>CanopyLabs.Quartz.EntityFrameworkCore.PostgreSQL</PackageId>
    <Version>3.19.1</Version>
    <Authors>Canopy Labs</Authors>
    <Description>EF Core migration support for Quartz.NET PostgreSQL tables</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>quartz;quartz.net;entityframeworkcore;efcore;postgresql;migrations</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/canopy-labs/Quartz.EntityFramework.Migrations</RepositoryUrl>
    <PackageProjectUrl>https://github.com/canopy-labs/Quartz.EntityFramework.Migrations</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CanopyLabs.Quartz.EntityFrameworkCore.PostgreSQL.Tests" />
  </ItemGroup>

</Project>
