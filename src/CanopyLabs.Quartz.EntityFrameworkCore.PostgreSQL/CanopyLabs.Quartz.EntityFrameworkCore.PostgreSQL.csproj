<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <PackageId>CanopyLabs.Quartz.EntityFrameworkCore.PostgreSQL</PackageId>
    <Version>4.7.0</Version>
    <Authors>Canopy Labs</Authors>
    <Description>EF Core migration support for Quartz.NET PostgreSQL tables</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>quartz;quartz.net;entityframeworkcore;efcore;postgresql;migrations</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/canopy-labs/Quartz.EntityFramework.Migrations</RepositoryUrl>
    <PackageProjectUrl>https://github.com/canopy-labs/Quartz.EntityFramework.Migrations</PackageProjectUrl>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
  </ItemGroup>

  <!-- Npgsql's EF Core 11 provider is still a release candidate. NuGet reads this as a
       minimum, so consumers move to 11.0.0 once it ships. NU5104 (stable package with a
       prerelease dependency) is suppressed for that reason; drop both once 11.0.0 is out. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CanopyLabs.Quartz.EntityFrameworkCore.PostgreSQL.Tests" />
  </ItemGroup>

</Project>
